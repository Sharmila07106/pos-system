# Express HTTP port (Render sets this automatically via process.env.PORT)
PORT=5090

# Runtime environment (development or production)
NODE_ENV=production

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/storeflow in local development)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/storeflow?retryWrites=true&w=majority

# Permit local MongoDB in production mode for testing only (set to true only for local tests)
ALLOW_LOCAL_DB=false

# Primary frontend URL (e.g., https://your-storeflow.vercel.app or http://localhost:5190)
CLIENT_URL=https://your-storeflow.vercel.app

# Comma-separated list of additional allowed CORS frontend origins
CORS_ORIGINS=https://your-storeflow.vercel.app,http://localhost:5191

# Automatically permit preview deployment URLs matching https://*.vercel.app
ALLOW_VERCEL_PREVIEWS=true

# Cryptographically strong secret key for JWT signing (minimum 32 characters)
JWT_SECRET=<long-random-secret>

# Expiration window for issued JWT tokens (e.g., 7d or 24h)
JWT_EXPIRES_IN=7d

# Initial password for Platform Super Admin during database seeding (minimum 8 characters)
SEED_PLATFORM_ADMIN_PASSWORD=<strong-admin-password>

# Initial password for Supermarket Owner during database seeding (minimum 8 characters)
SEED_STORE_ADMIN_PASSWORD=<strong-store-password>

# Initial password for Cashier Staff during database seeding (minimum 8 characters)
SEED_CASHIER_PASSWORD=<strong-cashier-password>

# Platform Super Admin login email address
PLATFORM_ADMIN_EMAIL=<admin-email>

# Platform Super Admin initial password
PLATFORM_ADMIN_PASSWORD=<strong-admin-password>

# SMTP email server hostname (optional for staff invite emails)
SMTP_HOST=smtp.gmail.com

# SMTP email server port (e.g. 587 or 465)
SMTP_PORT=587

# SMTP authentication username
SMTP_USER=your_email@gmail.com

# SMTP authentication password or app password
SMTP_PASS=your_app_specific_password

# Email sender address (e.g. StoreFlow <no-reply@storeflow.com>)
MAIL_FROM=StoreFlow <no-reply@storeflow.com>
