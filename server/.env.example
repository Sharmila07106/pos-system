# HTTP Port for the Express backend server (default: 5090)
PORT=5090

# Origin URL for the frontend client (e.g., http://localhost:5190 or http://localhost:5191)
CLIENT_URL=http://localhost:5190

# Secret key used for signing JWT authentication tokens
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Expiration window for issued JWT tokens (e.g., 7d or 24h)
JWT_EXPIRES_IN=7d

# MongoDB connection string (Atlas mongodb+srv:// or standard replica set URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/storeflow?retryWrites=true&w=majority

# Platform Super Administrator initial credentials for bootstrap and seeding
PLATFORM_ADMIN_NAME=Platform Administrator
PLATFORM_ADMIN_EMAIL=admin@storeflow.com
PLATFORM_ADMIN_PASSWORD=your_secure_password_here
